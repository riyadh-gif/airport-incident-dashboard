# Version control & CI
.git
.gitignore
.github

# Local environment & secrets (never bake into the image)
.env
.env.backup
.env.production
.env.*.local
auth.json

# Dependencies / build output (rebuilt inside the image)
vendor
node_modules
public/build
public/hot
public/storage

# Local SQLite database & runtime state
database/database.sqlite
storage/*.key
storage/logs/*
storage/framework/cache/data/*
storage/framework/sessions/*
storage/framework/views/*

# Caches & test artifacts
.phpunit.cache
.phpunit.result.cache
.phpactor.json

# Editor / OS noise
.idea
.vscode
.fleet
.nova
.zed
*.log
.DS_Store
Thumbs.db

# Docs that don't belong in the runtime image
docs/screenshots
*.md
!README.md
